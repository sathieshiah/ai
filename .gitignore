# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
.coverage.*

# Environment / secrets
.env
.env.*
!.env.example

# Data — tracked by shape, not by content
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Results are tracked - they are the deliverable. Keep them small:
# figures, tables, JSON. Bulk artefacts do not belong in git.
results/**/*.safetensors
results/**/*.bin
results/**/*.pt
results/**/*.npz
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Model weights (HF cache)
models/

# Single-slot hot copy of one model, left over from the removed src/research
# staging helper. Kept ignored so any stale copy stays out of git.
.model-cache/

# uv scratch dirs (this machine only)
.tmp/
.uv-cache/
# Retired venv. Two files under it are pending deletion and vanish on the next
# reboot; drop this line once .venv313/ is actually gone. The live venv is
# .venv/, ignored at the top of this file.
.venv313/
