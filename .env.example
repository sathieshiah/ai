# Copy to .env and fill in. .env is gitignored.

# Hugging Face token - needed for gated repos (Gemma, Llama) and higher
# download rate limits. Create one at https://huggingface.co/settings/tokens
# HF_TOKEN=

# HF_HUB_CACHE decides where weights land. Nothing in this repo sets it any
# more, so an unset value means downloads go to the profile cache on C:
# (~/.cache/huggingface). Point it at <project>/models to keep them on D:.
# HF_HUB_CACHE=

# Symlink creation fails on this machine (WinError 1314), which aborts a large
# download at the final file. Set this if you download weights locally.
# HF_HUB_DISABLE_SYMLINKS=1
