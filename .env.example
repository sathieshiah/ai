# Copy to .env and fill in. .env is gitignored.

# Hugging Face token - needed for gated repos (Gemma, Llama) and higher
# download rate limits. Create one at https://huggingface.co/settings/tokens
# HF_TOKEN=

# Overrides where model weights are cached. Leave unset: research/__init__.py
# pins this to <project>/models so weights land on D: rather than C:.
# HF_HUB_CACHE=
