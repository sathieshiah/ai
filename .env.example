# Copy to .env and fill in. .env is gitignored.

# Hugging Face token - needed for gated repos (Gemma, Llama) and higher
# download rate limits. Create one at https://huggingface.co/settings/tokens
# HF_TOKEN=

# HF_HUB_CACHE is NOT configurable here. research/__init__.py forces it to
# <project>/models so every model this project uses lives on D:, and never
# in the profile cache on C:. Setting it here has no effect.
